<launch>
  <arg name="input_topic" default="/ouster/points" />
  <arg name="odom_frame" default="odom" />

  <!-- window 내 누적할 프레임 수 -->
  <arg name="accumulator_window_frames" default="3" />
  <!-- 스캔 매칭하는 프레임 수 -->
  <arg name="accumulator_submap_frames" default="1" />
  <arg name="accumulator_publish_every_n_frames" default="1" />
  <arg name="accumulator_publish_only_full_window" default="false" />
  <arg name="accumulator_latency_log_enabled" default="false" />
  <arg name="accumulator_latency_log_path"
       default="/home/rain/online_static_feature_ws/output/latency_csv/ETRI_노은역/nRef50_1frame_accumulator.csv" />
  <arg name="registration_type" default="VGICP" />
  <arg name="registration_leaf_size" default="0.5" />
  <arg name="dense_leaf_size" default="0.0" />
  <arg name="max_correspondence_distance" default="2.0" />
  <arg name="voxel_resolution" default="1.0" />
  <arg name="num_threads" default="6" />

  <arg name="feature_window_frames" default="1" />
  <arg name="feature_publish_every_n_frames" default="1" />
  <!-- 0 = PLANAR/CORNER 분류 생략, scan_static_features 단일 토픽 발행 -->
  <arg name="use_feature_classification" default="0" />
  <arg name="publish_feature_history" default="false" />
  <arg name="save_on_shutdown_pcd" default="false" />
  <arg name="save_feature_history_path"
       default="/home/rain/online_static_feature_ws/output/pcd_map/ETRI_노은역/nRef50_2frame_v6.pcd" />
  <arg name="latency_log_enabled" default="false" />
  <arg name="latency_log_path"
       default="/home/rain/online_static_feature_ws/output/latency_csv/ETRI_노은역/nRef50_1frame.csv" />
  <arg name="max_feature_history_points" default="200000000" />

  <include file="$(find online_static_feature)/launch/scan_matching_accumulator.launch">
    <arg name="input_topic" value="$(arg input_topic)" />
    <arg name="odom_frame" value="$(arg odom_frame)" />
    <arg name="window_frames" value="$(arg accumulator_window_frames)" />
    <arg name="submap_frames" value="$(arg accumulator_submap_frames)" />
    <arg name="publish_every_n_frames" value="$(arg accumulator_publish_every_n_frames)" />
    <arg name="publish_only_full_window" value="$(arg accumulator_publish_only_full_window)" />
    <arg name="latency_log_enabled" value="$(arg accumulator_latency_log_enabled)" />
    <arg name="latency_log_path" value="$(arg accumulator_latency_log_path)" />
    <arg name="registration_type" value="$(arg registration_type)" />
    <arg name="registration_leaf_size" value="$(arg registration_leaf_size)" />
    <arg name="dense_leaf_size" value="$(arg dense_leaf_size)" />
    <arg name="max_correspondence_distance" value="$(arg max_correspondence_distance)" />
    <arg name="voxel_resolution" value="$(arg voxel_resolution)" />
    <arg name="num_threads" value="$(arg num_threads)" />
  </include>

  <include file="$(find online_static_feature)/launch/online_static_feature.launch">
    <arg name="cloud_topic" value="/scan_matching_accumulator_node/dense_window_cloud" />
    <arg name="pose_topic" value="/scan_matching_accumulator_node/scan_matching_pose" />
    <arg name="map_frame" value="$(arg odom_frame)" />
    <arg name="window_frames" value="$(arg feature_window_frames)" />
    <arg name="publish_every_n_frames" value="$(arg feature_publish_every_n_frames)" />
    <arg name="transform_with_pose" value="false" />
    <arg name="local_origin_mode" value="none" />
    <arg name="use_feature_classification" value="$(arg use_feature_classification)" />
    <arg name="publish_feature_history" value="$(arg publish_feature_history)" />
    <arg name="save_on_shutdown_pcd" value="$(arg save_on_shutdown_pcd)" />
    <arg name="max_feature_history_points" value="$(arg max_feature_history_points)" />
    <arg name="save_feature_history_path" value="$(arg save_feature_history_path)" />
    <arg name="latency_log_enabled" value="$(arg latency_log_enabled)" />
    <arg name="latency_log_path" value="$(arg latency_log_path)" />
  </include>
</launch>
